{
  "name": "EatACake-Lobby",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "ReactLua-Packages.rbxmx"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$className": "Folder",
        "ServerBootstrap": {
          "$path": "src/server/ServerBootstrap.server.lua"
        },
        "Common": {
          "$path": "src/server/common"
        },
        "Lobby": {
          "$path": "src/server/lobby"
        }
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$className": "Folder",
          "LocalBootstrap": {
            "$path": "src/client/LocalBootstrap.client.lua"
          },
          "Common": {
            "$path": "src/client/common"
          }
        }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
